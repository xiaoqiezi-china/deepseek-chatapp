{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "DeepSeek Chat 桌面端默认权限",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
