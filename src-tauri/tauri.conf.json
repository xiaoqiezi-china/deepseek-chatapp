{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deepseek CE",
  "version": "1.0.4",
  "identifier": "com.deepseek.chatapp",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:8090",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Deepseek CE",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "copyright": "Copyright (c) 2026 DeepSeek",
    "category": "Productivity",
    "shortDescription": "Deepseek CE",
    "longDescription": "Deepseek CE：基于 DeepSeek chat-demo 的社区版聊天客户端",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://gh-proxy.com/https://github.com/xiaoqiezi-china/deepseek-chatapp/releases/latest/download/latest.json",
        "https://ghfast.top/https://github.com/xiaoqiezi-china/deepseek-chatapp/releases/latest/download/latest.json",
        "https://ghproxy.net/https://github.com/xiaoqiezi-china/deepseek-chatapp/releases/latest/download/latest.json",
        "https://github.com/xiaoqiezi-china/deepseek-chatapp/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFMUU3RDYyQUU1QTUyNDcKUldSSFVscXVZbjBlUHFLaWJqRVMreGlBam92cXI5S3BBa2ZNZ2Nka2R1VG5nTVlYcXZRdi9Hb3YK"
    }
  }
}
