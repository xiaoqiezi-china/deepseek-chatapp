{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Chat",
  "version": "0.1.0",
  "identifier": "com.deepseek.chatapp",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:8090",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DeepSeek",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "copyright": "Copyright (c) 2026 DeepSeek",
    "category": "Productivity",
    "shortDescription": "DeepSeek Chat App",
    "longDescription": "Chat client based on DeepSeek chat-demo",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
